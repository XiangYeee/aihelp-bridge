{
  "mcpServers": {
    "zabbix-mcp": {
      "url": "http://${AIHELP_MCP_HOST}:18100/mcp",
      "type": "http"
    },
    "aihelp-apollo": {
      "url": "http://${AIHELP_MCP_HOST}:18101/mcp",
      "type": "http"
    },
    "aihelp-account": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp_http_stdio.py",
        "--port",
        "18102",
        "--auth",
        "mcp"
      ],
      "env": {
        "AIHELP_MCP_HOST": "${AIHELP_MCP_HOST}",
        "AIHELP_MCP_USER": "${AIHELP_MCP_USER}",
        "AIHELP_MCP_PASS": "${AIHELP_MCP_PASS}"
      }
    },
    "aihelp-wiki": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp_http_stdio.py",
        "--port",
        "18103",
        "--auth",
        "mcp"
      ],
      "env": {
        "AIHELP_MCP_HOST": "${AIHELP_MCP_HOST}",
        "AIHELP_MCP_USER": "${AIHELP_MCP_USER}",
        "AIHELP_MCP_PASS": "${AIHELP_MCP_PASS}"
      }
    },
    "aihelp-gitlab": {
      "url": "http://${AIHELP_MCP_HOST}:18104/mcp",
      "headers": {
        "Authorization": "Bearer ${AIHELP_GITLAB_MCP_TOKEN}"
      },
      "type": "http"
    },
    "aihelp-jenkins": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp_http_stdio.py",
        "--port",
        "18105",
        "--auth",
        "mcp"
      ],
      "env": {
        "AIHELP_MCP_HOST": "${AIHELP_MCP_HOST}",
        "AIHELP_MCP_USER": "${AIHELP_MCP_USER}",
        "AIHELP_MCP_PASS": "${AIHELP_MCP_PASS}"
      }
    },
    "aihelp-zentao": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp_http_stdio.py",
        "--port",
        "18106",
        "--auth",
        "mcp"
      ],
      "env": {
        "AIHELP_MCP_HOST": "${AIHELP_MCP_HOST}",
        "AIHELP_MCP_USER": "${AIHELP_MCP_USER}",
        "AIHELP_MCP_PASS": "${AIHELP_MCP_PASS}"
      }
    },
    "aihelp-elk": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp_http_stdio.py",
        "--port",
        "18107",
        "--auth",
        "mcp"
      ],
      "env": {
        "AIHELP_MCP_HOST": "${AIHELP_MCP_HOST}",
        "AIHELP_MCP_USER": "${AIHELP_MCP_USER}",
        "AIHELP_MCP_PASS": "${AIHELP_MCP_PASS}"
      }
    },
    "aihelp-db": {
      "url": "http://${AIHELP_MCP_HOST}:18108/mcp",
      "type": "http"
    },
    "jumpserver": {
      "url": "http://${AIHELP_MCP_HOST}:18109/mcp",
      "headers": {
        "Authorization": "AccessKey ${JUMPSERVER_MCP_ACCESSKEY}"
      },
      "type": "http"
    },
    "aihelp-langfuse": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp_http_stdio.py",
        "--port",
        "18111",
        "--auth",
        "langfuse"
      ],
      "env": {
        "AIHELP_MCP_HOST": "${AIHELP_MCP_HOST}",
        "AIHELP_LANGFUSE_MCP_USER": "${AIHELP_LANGFUSE_MCP_USER}",
        "AIHELP_LANGFUSE_MCP_PASS": "${AIHELP_LANGFUSE_MCP_PASS}"
      }
    }
  }
}
