{
  "name": "aihelp-bridge",
  "version": "0.4.1",
  "description": "须连公司内网或 VPN。安装时填写 settings（不会读取本机环境变量），值不要带 Basic/Bearer/AccessKey 前缀。\n1. AIHELP_MCP_HOST：MCP 网关主机或 IP，不要 http:// 和端口，向同事索取\n2. AIHELP_MCP_USER：MCP HTTP 用户名\n3. AIHELP_MCP_PASS：MCP HTTP 密码，填明文，不要 Base64\n4. AIHELP_GITLAB_MCP_TOKEN：GitLab Access Tokens，权限含 api，只填 token\n5. JUMPSERVER_MCP_ACCESSKEY：JumpServer API Key，填 id:secret\n6. AIHELP_LANGFUSE_MCP_USER：Langfuse MCP 用户名\n7. AIHELP_LANGFUSE_MCP_PASS：Langfuse MCP 密码，填明文，不要 Base64",
  "contextFileName": "GEMINI.md",
  "settings": [
    {
      "name": "AIHelp MCP Host",
      "description": "MCP 网关主机名或 IP，不要 http://，不要端口。向同事或内部文档索取。",
      "envVar": "AIHELP_MCP_HOST",
      "sensitive": false
    },
    {
      "name": "AIHelp MCP User",
      "description": "account/wiki/jenkins/zentao/elk 的 HTTP 用户名。填明文。",
      "envVar": "AIHELP_MCP_USER",
      "sensitive": false
    },
    {
      "name": "AIHelp MCP Password",
      "description": "account/wiki/jenkins/zentao/elk 的 HTTP 密码。填明文，不要 Base64，不要加 Basic 前缀。",
      "envVar": "AIHELP_MCP_PASS",
      "sensitive": true
    },
    {
      "name": "GitLab MCP Token",
      "description": "公司 GitLab → Preferences → Access Tokens，权限含 api。只填 token，不要加 Bearer。",
      "envVar": "AIHELP_GITLAB_MCP_TOKEN",
      "sensitive": true
    },
    {
      "name": "JumpServer AccessKey",
      "description": "JumpServer 个人中心 API Key，填 id:secret，不要加 AccessKey 前缀。",
      "envVar": "JUMPSERVER_MCP_ACCESSKEY",
      "sensitive": true
    },
    {
      "name": "Langfuse MCP User",
      "description": "Langfuse MCP 用户名。填明文。",
      "envVar": "AIHELP_LANGFUSE_MCP_USER",
      "sensitive": false
    },
    {
      "name": "Langfuse MCP Password",
      "description": "Langfuse MCP 密码。填明文，不要 Base64，不要加 Basic 前缀。",
      "envVar": "AIHELP_LANGFUSE_MCP_PASS",
      "sensitive": true
    }
  ],
  "mcpServers": {
    "zabbix-mcp": {
      "httpUrl": "http://${AIHELP_MCP_HOST}:18100/mcp"
    },
    "aihelp-apollo": {
      "httpUrl": "http://${AIHELP_MCP_HOST}:18101/mcp"
    },
    "aihelp-account": {
      "command": "python3",
      "args": [
        "${extensionPath}/scripts/mcp_http_stdio.py",
        "--port",
        "18102",
        "--auth",
        "mcp"
      ],
      "env": {
        "AIHELP_MCP_HOST": "${AIHELP_MCP_HOST}",
        "AIHELP_MCP_USER": "${AIHELP_MCP_USER}",
        "AIHELP_MCP_PASS": "${AIHELP_MCP_PASS}"
      }
    },
    "aihelp-wiki": {
      "command": "python3",
      "args": [
        "${extensionPath}/scripts/mcp_http_stdio.py",
        "--port",
        "18103",
        "--auth",
        "mcp"
      ],
      "env": {
        "AIHELP_MCP_HOST": "${AIHELP_MCP_HOST}",
        "AIHELP_MCP_USER": "${AIHELP_MCP_USER}",
        "AIHELP_MCP_PASS": "${AIHELP_MCP_PASS}"
      }
    },
    "aihelp-gitlab": {
      "httpUrl": "http://${AIHELP_MCP_HOST}:18104/mcp",
      "headers": {
        "Authorization": "Bearer ${AIHELP_GITLAB_MCP_TOKEN}"
      }
    },
    "aihelp-jenkins": {
      "command": "python3",
      "args": [
        "${extensionPath}/scripts/mcp_http_stdio.py",
        "--port",
        "18105",
        "--auth",
        "mcp"
      ],
      "env": {
        "AIHELP_MCP_HOST": "${AIHELP_MCP_HOST}",
        "AIHELP_MCP_USER": "${AIHELP_MCP_USER}",
        "AIHELP_MCP_PASS": "${AIHELP_MCP_PASS}"
      }
    },
    "aihelp-zentao": {
      "command": "python3",
      "args": [
        "${extensionPath}/scripts/mcp_http_stdio.py",
        "--port",
        "18106",
        "--auth",
        "mcp"
      ],
      "env": {
        "AIHELP_MCP_HOST": "${AIHELP_MCP_HOST}",
        "AIHELP_MCP_USER": "${AIHELP_MCP_USER}",
        "AIHELP_MCP_PASS": "${AIHELP_MCP_PASS}"
      }
    },
    "aihelp-elk": {
      "command": "python3",
      "args": [
        "${extensionPath}/scripts/mcp_http_stdio.py",
        "--port",
        "18107",
        "--auth",
        "mcp"
      ],
      "env": {
        "AIHELP_MCP_HOST": "${AIHELP_MCP_HOST}",
        "AIHELP_MCP_USER": "${AIHELP_MCP_USER}",
        "AIHELP_MCP_PASS": "${AIHELP_MCP_PASS}"
      }
    },
    "aihelp-db": {
      "httpUrl": "http://${AIHELP_MCP_HOST}:18108/mcp"
    },
    "jumpserver": {
      "httpUrl": "http://${AIHELP_MCP_HOST}:18109/mcp",
      "headers": {
        "Authorization": "AccessKey ${JUMPSERVER_MCP_ACCESSKEY}"
      }
    },
    "aihelp-langfuse": {
      "command": "python3",
      "args": [
        "${extensionPath}/scripts/mcp_http_stdio.py",
        "--port",
        "18111",
        "--auth",
        "langfuse"
      ],
      "env": {
        "AIHELP_MCP_HOST": "${AIHELP_MCP_HOST}",
        "AIHELP_LANGFUSE_MCP_USER": "${AIHELP_LANGFUSE_MCP_USER}",
        "AIHELP_LANGFUSE_MCP_PASS": "${AIHELP_LANGFUSE_MCP_PASS}"
      }
    }
  }
}
